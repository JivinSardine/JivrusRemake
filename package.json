{
  "name": "jivrus-remake",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Faithful reconstruction of the Jivrus Technologies public website (jivrus.com) with modern motion design.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "astro check",
    "validate:routes": "node scripts/validate-routes.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:images": "node scripts/validate-images.mjs",
    "validate:responsive": "node scripts/validate-responsive.mjs",
    "validate:contrast": "node scripts/validate-contrast.mjs",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa:a11y": "node scripts/a11y-audit-fast.mjs",
    "qa:a11y:full": "node scripts/a11y-audit.mjs",
    "qa:all": "npm run validate:routes && npm run validate:links && npm run validate:assets",
    "verify:live": "node scripts/verify-live.mjs",
    "sweep": "node scripts/sweep.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "gsap": "^3.12.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2"
  }
}