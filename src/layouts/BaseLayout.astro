---
import { withBase } from '~/lib/urls';
/**
 * BaseLayout — the document shell shared by all 92 routes.
 *
 * Handles: fonts, global CSS, the skip link, SEO/OG/Twitter metadata,
 * canonical URLs, JSON-LD, and the header/footer/motion wiring.
 */
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

export interface Props {
  title: string;
  description: string;
  /** Absolute canonical path on the live site, e.g. '/legal/privacy-policy'. */
  route: string;
  ogImage?: string;
  family?: string;
  /** JSON-LD graph node for this page. */
  schema?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title,
  description,
  route,
  ogImage = '/og-default.svg',
  family = 'default',
  schema,
  noindex = false,
} = Astro.props;

/**
 * Canonical and og:image URLs must be absolute, but their origin depends on
 * where this build is being served from. `SITE_ORIGIN` lets a deployment
 * override the default; on GitHub Pages the Pages URL is the honest origin,
 * and pointing og:image at an unrelated host would leave the social card blank.
 */
const SITE_ORIGIN = import.meta.env.SITE_ORIGIN || 'https://www.jivrus.com';
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `${SITE_ORIGIN}${BASE}${route === '/' ? '/' : route}`;
const ogImageUrl = new URL(withBase(ogImage), SITE_ORIGIN).toString();
const isHome = route === '/' || route === '/home';
const fullTitle = title.includes('Jivrus') ? title : `${title} | Jivrus Technologies`;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Jivrus Technologies',
  url: SITE_ORIGIN,
  description:
    'Jivrus Technologies builds software products and integrations for intelligent integration and hyper-automation.',
  sameAs: [
    'https://www.facebook.com/jivrus/',
    'https://www.linkedin.com/company/jivrus/',
    'https://www.instagram.com/jivrus/',
    'https://x.com/jivrus',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: 'support@jivrus.com',
  },
};

const graph: Record<string, unknown>[] = [organization];
if (schema) graph.push(schema);
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jivrus Technologies" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}

    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("/favicon.svg")} />

    <!-- Fonts: the live site loads Roboto (headings/body) and Comfortaa (brand). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Comfortaa:wght@400;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(
      graph.length === 1 ? graph[0] : { '@context': 'https://schema.org', '@graph': graph }
    )} />
  </head>

  <body data-page={isHome ? 'home' : 'page'} data-family={family}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
