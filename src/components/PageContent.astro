---
/**
 * PageContent — renders a route's extracted page model using the live site's own
 * layout grammar: a magenta strip between sections, prose for copy, card grids
 * for listings, with the original block order preserved exactly.
 */
import type { Block, Section } from '~/types';
import SectionStrip from './SectionStrip.astro';
import BlockView from './BlockView.astro';
import { withBase } from '~/lib/urls';

/** Block tags that open a new card. */
const HEADING_TAGS = new Set(['h1', 'h2', 'h3', 'h4', 'h5', 'h6']);

/** A customer logo with the website and country it belongs to. */
interface CustomerTile {
  src: string;
  alt: string;
  website: string;
  country: string;
}

export interface Props {
  sections: Section[];
}
const { sections } = Astro.props;

/**
 * Picks the presentation for a run of blocks.
 *
 * The live site is mostly continuous prose with h2/h3 subheads, so `prose` is
 * the default and must stay WHITE. Blush is only for genuine card/logo grids,
 * which are exactly the runs that are mostly images or many short list items.
 */
function layoutFor(
  blocks: Block[],
  section?: { customer_tiles?: CustomerTile[] }
): 'grid' | 'list' | 'prose' | 'tiles' {
  // A section that carries its own explicit pairing must reach the tiles branch
  // that renders it. /customers has 18 headings and 36 images, so without this
  // the heading-led rule below claimed it and the pairing was never used.
  if (section?.customer_tiles?.length) return 'tiles';
  const tags = blocks.map((b) => b.tag);
  const imgs = tags.filter((t) => t === 'img').length;
  const lis = tags.filter((t) => t === 'li').length;
  // A run led by a heading and then mostly artwork is a tile gallery, not a
  // card grid. The brand kit (/about/branding) lays its logos out four to a
  // row; the generic card grid pads each image into a box as tall as the
  // tallest cell in its row, which made that page 50% taller than the source.
  // Judge on the run AFTER the heading, since the heading and its explanatory
  // paragraphs are copy, not tiles.
  const head = blocks.find((b) => b.tag === 'h1' || b.tag === 'h2' || b.tag === 'h3');
  const body = head ? blocks.filter((b) => b !== head) : blocks;
  const bodyImgs = body.filter((b) => b.tag === 'img').length;
  /*
   * The core products are `h3 "Starch", img`, `h3 "Form", img`, ... - a
   * heading naming each image. That is the same shape as a card grid, and the
   * grid branch groups a heading with its artwork, so the name sits with its
   * logo and the heading's anchor id survives. The tiles branch pairs by index
   * instead, which separated every name from its logo and left #form, #bloom
   * and #flow with no target at all.
   */
  const headings = blocks.filter((b) => HEADING_TAGS.has(b.tag)).length;
  if (headings >= 3 && imgs >= 3) return 'grid';
  if (imgs >= 4 && bodyImgs >= body.length * 0.45) return 'tiles';
  // Image-led run => card grid (testimonials, customers, history, partners).
  if (imgs >= 3) return 'grid';
  // Many short sibling list items => a listing, not a document.
  if (lis >= 4 && lis >= tags.length * 0.6) return 'list';
  return 'prose';
}

/**
 * A card must not contain a bare <li>: list items need a list parent, or the
 * meaning is lost to assistive tech. Runs containing <li> render as a list.
 */
function hasListItem(blocks: Block[]): boolean {
  return blocks.some((b) => b.tag === 'li');
}
---

{
  sections.map((section) => {
    if (section.kind === 'strip' && section.title) {
      return <SectionStrip title={section.title} />;
    }
    const blocks = section.blocks ?? [];
    // A section may be copy-only, e.g. once its artwork has been split out.
    if (!blocks.length) {
      if (!section.copy?.length) return null;
      return (
        <section class="section">
          <div class="container prose">
            {section.copy.map((b) => (
              <BlockView block={b} />
            ))}
          </div>
        </section>
      );
    }
    const mode = layoutFor(blocks, section);

    // A card is a heading plus the blocks up to the next heading. A run with no
    // heading at all keeps one block per card, which is what it always did.
    const cards: Block[][] = [];
    for (const b of blocks) {
      if (HEADING_TAGS.has(b.tag) || !cards.length) cards.push([b]);
      else cards[cards.length - 1].push(b);
    }

    // A run that contains <li> is a list: give it a real <ul> so the list
    // semantics survive. Never put a bare <li> inside a card or a <div>.
    //
    // The <ul> holds the <li>s, and each <li> is the BlockView — wrapping the
    // item in a second <li> put a list item inside a list item, which is
    // invalid and left the text in a second, redundant box.
    // A run that is mostly artwork is a gallery even if a few rows came
    // through as <li>: /products' Product Suite has 22 images and 6 <li>, and
    // the list branch was winning, so all 22 images were dropped and the
    // section rendered as bare text. Only take the list branch when the run is
    // genuinely list-shaped.
    const listish = hasListItem(blocks) && mode !== 'tiles';
    if (listish) {
      return (
        <section class="section">
          <div class="container">
            <ul class="listing" data-stagger>
              {blocks.map((b) => (
                <li class="listing__item" data-stagger-item>
                  <BlockView block={b} inline as="div" />
                </li>
              ))}
            </ul>
          </div>
        </section>
      );
    }

    // An image-led run renders as a compact tile gallery: the heading spans
    // the full width, then the artwork sits four to a row the way the source
    // lays out the brand kit. The generic card grid would pad every image
    // into a box as tall as the tallest cell in its row.
    //
    // Captions are paired with the image they describe. The extraction stores
    // them as siblings - `img, "Perfectly proportionate logo", img, ...` - so
    // without pairing, a caption becomes its own grid cell and lands in the
    // next column from the logo it belongs to.
    if (mode === 'tiles') {
      const heading = blocks.find((b) => b.tag === 'h1' || b.tag === 'h2' || b.tag === 'h3');
      const rest = blocks.filter((b) => b !== heading);

      // Pairing, derived from how the source stores these runs.
      //
      // A logo group is a set of images with a matching set of labels:
      //
      //     img, img, "Perfectly proportionate logo",
      //     img, "Monochrome in dark background", ...
      //
      // The labels are NOT adjacent to the image they name - the first label
      // follows two images - so pairing each label with the image in front of
      // it shifts every caption one column to the right. Pair by index: the
      // nth label belongs to the nth image.
      //
      // A section's own copy (the lifted prose, plus any name with no artwork
      // to attach to) stays full width above the grid.
      /*
       * When a section carries an explicit pairing, use it verbatim.
       *
       * /customers stores two images per customer followed by its website and
       * country, and inferring the pairing was wrong: index pairing put every
       * logo under the next company's website. The pairing is computed once,
       * by scripts/pair-customer-logos.py, and recorded in `customer_tiles`, so
       * the renderer never has to guess.
       */
      const explicit = (section as { customer_tiles?: CustomerTile[] }).customer_tiles;
      if (explicit?.length) {
        return (
          <section class="section section--blush">
            <div class="container">
              {heading && <BlockView block={heading} />}
              <div class="tiles" data-stagger>
                {explicit.map((t) => {
                  // The extracted logos carry no alt text, so a link wrapping
                  // one has no accessible name. Name it after the company the
                  // tile belongs to; fall back to the filename when a variant
                  // has no site of its own.
                  const name =
                    t.alt ||
                    (t.website
                      ? `${t.website} logo`
                      : `${t.country || 'Customer'} logo`);
                  const logo = (
                    <img src={withBase(t.src)} alt={name} loading="lazy" decoding="async" />
                  );
                  return (
                    <figure class="tile tile--customer" data-stagger-item>
                      {t.website ? (
                        <a
                          class="tile__logo"
                          href={`https://${t.website}`}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {logo}
                        </a>
                      ) : (
                        // The source shows a second, monochrome variant for some
                        // customers with no site link. Render it plainly rather
                        // than an <a> pointing at an empty host.
                        <span class="tile__logo">{logo}</span>
                      )}
                      <figcaption>
                        {t.website && <span class="tile__site">{t.website}</span>}
                        {t.country && <span class="tile__country">{t.country}</span>}
                      </figcaption>
                    </figure>
                  );
                })}
              </div>
            </div>
          </section>
        );
      }

      // Pairing depends on the shape of the run, and there are two shapes:
      //
      //   ALTERNATING - image, label, image, label: a label directly after an
      //     image names that image, so pair by adjacency.
      //
      //   COLLECTED - the images come first and the labels follow as a run:
      //     img, img, "Perfectly proportionate logo", img, "Monochrome in dark
      //     background" on the brand kit. Pair by index.
      //
      // Pairing /customers by index put every caption one tile out: a logo
      // appeared under the wrong company, and the country headings ("India",
      // "USA") were used as captions.
      // Decide the shape from the run itself: if the first text arrives
      // immediately after the first image, the run alternates. On /customers
      // that is `img, "www.byjus.com", img, "India", ...`; on the brand kit it
      // is `img, img, "Perfectly proportionate logo", ...`.
      /*
       * The source's shape here is a repeating PAIR plus its caption:
       *
       *     img, img, "Integrate your software and systems", img, img,
       *     "Automate documents & forms", ...
       *
       * two artwork items - an icon and its logo - then the text naming them.
       * An earlier version only handled a strictly alternating run
       * (`img, "label", img, "label"`), so every one of these captions was left
       * as loose copy and the artwork rendered as a grid of unlabelled cards.
       *
       * So: flush a run of consecutive images, then attach the following text
       * to the LAST image of the run - the one immediately above it. The same
       * caption appears twice in the extraction (an <li> and a <p>); the
       * duplicate is dropped rather than rendered twice.
       */
      const tiles: { img: Block; label: Block | null }[] = [];
      let run: Block[] = [];
      const flushRun = () => {
        for (const img of run) tiles.push({ img, label: null });
        run = [];
      };
      let lastLabel = '';
      for (const b of rest) {
        if (b.tag === 'img') {
          run.push(b);
          continue;
        }
        flushRun();
        if (HEADING_TAGS.has(b.tag)) continue;
        const last = tiles[tiles.length - 1];
        const text = (b.text ?? '').trim();
        // a repeat of the caption we just placed, and there is no new image for
        // it: drop it
        if (!last || last.label || (text && text === lastLabel)) continue;
        last.label = b;
        lastLabel = text;
      }
      flushRun();

      // Any text that no image claimed, e.g. a country heading that introduces
      // a group, is kept as section copy rather than being silently dropped.
      const claimed = new Set(tiles.map((t) => t.label).filter(Boolean));
      /*
       * Orphan text is text no image claimed. A caption whose text is ALREADY
       * shown on a tile is not an orphan - it is the duplicate <li>/<p> twin the
       * extraction emits, and rendering it as loose copy printed every
       * capability name a second time in a column above the gallery.
       */
      const shown = new Set(
        tiles.map((t) => (t.label?.text ?? '').trim()).filter(Boolean)
      );
      const orphanLabels = rest.filter(
        (b) => b.tag !== 'img' && !claimed.has(b) && !shown.has((b.text ?? '').trim())
      );

      return (
        <section class="section section--blush">
          <div class="container">
            {heading && <BlockView block={heading} />}
            {section.copy?.map((b) => (
              <div class="tiles__copy tiles__copy--lead">
                <BlockView block={b} />
              </div>
            ))}
            {orphanLabels.length > 0 && (
              <div class="tiles__copy tiles__copy--names">
                {orphanLabels.map((b) => (
                  <BlockView block={b} />
                ))}
              </div>
            )}
            <div class="tiles" data-stagger>
              {tiles.map((t) => (
                <figure class="tile" data-stagger-item>
                  <BlockView block={t.img} />
                  {t.label && <figcaption>{(t.label.text ?? '').trim()}</figcaption>}
                </figure>
              ))}
            </div>
          </div>
        </section>
      );
    }

    return (
      <section class:list={['section', { 'section--blush': mode === 'grid' }]}>
        <div class="container">
          {mode === 'prose' && (
            <div class="prose">
              {blocks.map((b) => (
                <BlockView block={b} />
              ))}
            </div>
          )}
          {mode === 'grid' && (
            /*
             * Group a heading with the artwork that follows it, so a card is
             * one product rather than one stray element. Rendering each block
             * as its own card put every <h3> in a cell of its own, away from
             * the logo it names, and left the heading's `anchor` id on the
             * section heading alone - so only one of six core-product links
             * resolved.
             */
            <div class:list={['grid', cards.length >= 6 ? 'grid--6' : 'grid--3']} data-stagger>
              {cards.map((card) => (
                <div class="card" data-stagger-item>
                  {card.map((b) => (
                    <BlockView block={b} />
                  ))}
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    );
  })
}

<style>
  /*
   * Six to a row, for the core products. The source lays Starch, Form, Bloom,
   * Flow, MCP Server and AI Agent across a single row; the default three-up
   * grid wrapped them onto two.
   */
  .grid--6 {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  @media (max-width: 1100px) {
    .grid--6 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .grid--6 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /*
   * Tile gallery. Four to a row, matching the source's brand kit, with no
   * padded card box: the artwork keeps its own aspect ratio and the label sits
   * directly beneath it, so a row is only as tall as its tallest tile.
   */
  .tiles {
    display: grid;
    /* minmax(0, 1fr) rather than minmax(240px, 1fr): a min-content floor lets a
       long unbreakable caption set the track width and overflow the page. */
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px 18px;
    align-items: start;
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    margin: 0;
    /* Grid items default to min-content width, so a long caption can push the
       column wider than the viewport on a phone. Both of these let the column
       shrink to the track size. */
    min-width: 0;
    max-width: 100%;
  }

  /*
   * Every tile in a row must be the same height, or the grid goes ragged:
   * /customers rendered its logo tiles between 173px and 297px tall in a single
   * row, because a wide 1.9:1 logo and a square one both took their natural
   * height at the same column width. A fixed box with object-fit: contain
   * letterboxes the artwork instead of stretching it, so a row of mixed aspect
   * ratios still lines up.
   */
  .tile :global(img) {
    width: 100%;
    /* A fixed-height band with contain: the artwork is letterboxed inside it,
       so it keeps its true proportions and every tile in a row is the same
       height. Without this a 1.9:1 logo and a square one take different
       heights at the same column width and the grid reads as jumbled. */
    height: 180px;
    object-fit: contain;
  }

  .tile--customer .tile__logo {
    display: block;
    width: 100%;
  }

  .tile__site {
    display: block;
    font-weight: 500;
    color: var(--jivrus-magenta);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tile__country {
    display: block;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .tile figcaption {
    font-size: 13px;
    line-height: 1.4;
    min-height: 2.8em;
    color: var(--jivrus-ink-soft, #555);
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .tile figcaption :global(p) {
    font-size: inherit;
    line-height: inherit;
    margin: 0;
    color: inherit;
  }

  /* Copy that is not a caption keeps its own full-width line below the grid,
     the way the source sets an explanatory paragraph under the artwork. */
  .tiles__copy {
    max-width: 78ch;
    margin: 20px auto 0;
  }

  .tiles__copy--lead {
    margin: 0 0 22px;
  }

  /* A list of product names with no artwork of their own: set them as a
     wrapping row of labels rather than a paragraph. */
  .tiles__copy--names {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin: 0 0 22px;
    font-size: 14px;
    color: var(--jivrus-ink-soft, #555);
  }

  @media (max-width: 900px) {
    .tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .tile :global(img) {
      height: 150px;
    }
  }

  @media (max-width: 640px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tile :global(img) {
      height: 120px;
    }
  }

  .listing {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 18px;
  }

  .listing__item {
    background: var(--jivrus-white);
    border-radius: var(--radius);
    padding: 16px 18px;
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .listing__item:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .listing__item :global(.block--h1),
  .listing__item :global(.block--h2),
  .listing__item :global(.block--h3) {
    font-size: 17px;
    margin-bottom: 0.2em;
  }
</style>
