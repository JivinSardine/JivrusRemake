---
import { withBase } from '~/lib/urls';
/**
 * The homepage, rebuilt to the source layout.
 *
 * Order and copy come straight from the live page (see the block dump in
 * recon/): announcement -> gradient hero -> portal band -> Products strip ->
 * Product Suite -> What we do? -> Testimonials -> Customers -> Partners ->
 * History -> Say hi. The only addition is the motion layer.
 */
import SectionStrip from '~/components/SectionStrip.astro';
import home from '~/data/pages/root.json';

/*
 * Page data has already been rewritten to local /images/... paths by the
 * localisation step, so no CDN URL should remain. If one ever does (a page
 * captured before the pass), imageMap translates it; otherwise use it as-is.
 */
import imageMap from '~/data/image-map.json';
const local = (src: string) => (src?.startsWith('/images/') ? src : imageMap[src] || src);

/** Unique, source-ordered images on the homepage. */
const allImages = [...new Map((home.images || []).map((i) => [i.src, i])).values()];
const bySize = (min: number) => allImages.filter((i) => i.w >= min && i.h >= min);
/** The hero illustration: the widest, tallest artwork. */
const heroArt = [...allImages].sort((a, b) => b.w * b.h - a.w * a.h)[0];
/** The radial product-suite diagram sits in the Products section. */
const productSuite = bySize(700).find((i) => i !== heroArt);
/** Customer and partner logo tiles. */
const logoTiles = allImages.filter((i) => i.w >= 120 && i.w <= 460 && i.h <= 320);

const customers = [
  { site: 'www.byjus.com', country: 'India' },
  { site: 'eastbronxacademy.org', country: 'USA' },
  { site: 'www.sheffield.ac.uk', country: 'United Kingdom' },
  { site: 'www.scdsb.on.ca', country: 'Canada' },
  { site: 'www.phonepe.com', country: 'India' },
  { site: 'www.ualberta.ca', country: 'Canada' },
  { site: 'www.woundcaresurgeons.org', country: 'USA' },
  { site: 'www.edmonton.ca', country: 'Canada' },
  { site: 'www.sayitwithasock.com', country: 'USA' },
  { site: 'www.policystreet.com', country: 'Malaysia' },
  { site: 'www.tdsb.on.ca', country: 'Canada' },
  { site: 'www.rockingxranch.com', country: 'USA' },
  { site: 'www.asu.edu', country: 'USA' },
  { site: 'www.appliedintuition.com', country: 'USA' },
  { site: 'myhappygenes.com', country: 'USA' },
  { site: '360payments.com', country: 'USA' },
];

/**
 * Testimonials, verbatim from the source. The source renders some quotes as a
 * heading and some as body copy, so `asHeading` records that faithfully: the
 * heading is emitted as an <h3> and the attribution line as its own paragraph.
 */
const testimonials = [
  {
    quote:
      'A great app to generate a Google Doc from a form. We use it for testimonials and it works a treat. The students provides the data and the teachers can verify it by sharing with other staff. It saves so much time and energy, not more passing a form around!',
    who: 'Dawn Siso',
    asHeading: true,
  },
  {
    quote:
      '"Amazing and affordable service! Great full stack options. Super swift support and they think with your case for possible features requests. After my request to Jivrus Technologies now they made Stripe automated invoicing and payment processing possible. Never experiences such a good software tool and support."',
    who: 'Roy van der Steen',
    asHeading: true,
  },
  {
    quote:
      "I have been using Form Director for years. I set it up so teachers in my school can easily send me announcements that my students read on our daily newscast in our school.\nIt is an easy way for teachers to send me the info they want read to the school. It saves me a ton of effort and once set, you can just let it do it's thing! I could not recommend it more highly. Great product!",
    who: "Peter O'Farrell",
    asHeading: false,
  },
  {
    quote:
      'This is a great product produced by a team of people that are responsive to their user base. I submitted a request for a addition to functionality that was answered promptly and implemented quickly. Highly recommend.',
    who: 'Taylor Smith',
    asHeading: true,
  },
  {
    quote:
      'First time using this add-on. Very user friendly and easy to navigate. When I had an issue with Required fields Support was great! They fixed the problem and allowed my doc to function as needed. This is what Customer Service should be! Thank you!',
    who: 'Pam Kieslich',
    asHeading: true,
  },
];

/**
 * The timeline. The source puts the whole milestone — date and label — in one
 * heading, so the heading text is the source's text and `text` is the label
 * rendered underneath it.
 */
const history = [
  { date: 'Dec 2015 - The idea 💡' },
  { date: 'Jan 2019 - Partnered with Zoho' },
  { date: 'May 2016 - Company launched' },
  { date: 'Jul 2018 - Launched Form Builder' },
  { date: 'Apr 2017 - Launch of Fillable Document' },
  { date: 'Aug 2018 - Launched Map My Sheet' },
  { date: 'May 2017 - Partnered with Google' },
  { date: 'Feb 2019 - Launched Sheet Director' },
  { date: 'Jul 2017 - Launch of Database Browser' },
  { date: 'May 2020 - Launched Form Presenter' },
  { date: 'Jan 2018 - Moved into Springboard office space' },
  { date: 'May 2021 - Launched Worksheet Director' },
  { date: 'May 2018 - Launched Form Director' },
  { date: 'Oct 2021 - AppiWorks Platform - Soft launch' },
];

const products = [
  { id: 'form-builder', name: 'Form Builder' },
  { id: 'form-presenter', name: 'Form Presenter' },
  { id: 'form-director', name: 'Form Director' },
  { id: 'fillable-document', name: 'Fillable Document' },
  { id: 'database-browser', name: 'Database Browser' },
  { id: 'sheet-director', name: 'Sheet Director' },
  { id: 'map-my-sheet', name: 'Map My Sheet' },
  { id: 'appiworks', name: 'AppiWorks' },
];
---


  <!-- ============================================================ hero -- -->
  <section class="hero">
    <div class="hero__grid container">
      <div class="hero__copy">
        <p class="hero__title" data-hero>
          We Make Customers Succeed
        </p>
        <p class="hero__sub" data-hero>
          with intelligent integration &amp; hyper-automations.<span class="hero__sub-tail"
            >awesome software products worldwide</span
          >
        </p>
        <div class="btn-row hero__btns" data-hero>
          <a class="btn btn--ghost-light" href={withBase("/support/schedule-a-demo")}>
            Sign in to Customer Portal
          </a>
          <a class="btn btn--ghost-light" href={withBase("/about/contact-us")}>Chat with us</a>
        </div>
        <ul class="hero__links" data-hero>
          <li><a href={withBase("/support/faq")}>FAQs</a></li>
          <li><a href="mailto:support@jivrus.com">Email: support@jivrus.com</a></li>
          <li class="hero__wa">WhatsApp +91 79754 86266Mon-Fri 9:00 AM to 7:00 PM IST</li>
          <li><a href={withBase("/about/contact-us")}>Contact Us</a></li>
        </ul>
      </div>
      <div class="hero__art" data-hero>
        {
          heroArt && (
            <img
              class="hero__art-img"
              src={withBase(local(heroArt.src))}
              alt={heroArt.alt || 'Jivrus integration and automation platform diagram'}
              width={heroArt.w || undefined}
              height={heroArt.h || undefined}
              fetchpriority="high"
              decoding="async"
            />
          )
        }
      </div>
    </div>
  </section>

  <!-- ==================================================== portal band -- -->
  <section class="portal section--tight">
    <div class="container portal__grid">
      <div class="portal__copy">
        <h1 class="portal__title" data-reveal>Digital Transformation starts with You !</h1>
        <h2 class="portal__sub" data-reveal>
          Get started with intelligent integrations and powerful automation.
        </h2>
      </div>
      <div class="portal__card" data-reveal>
        <p class="portal__card-text">
          Sign in to the Jivrus Customer Portal to manage your products, licences and support.
        </p>
        <div class="btn-row portal__card-btns">
          <a class="btn btn--primary" href={withBase("/support/schedule-a-demo")}>Get Started</a>
          <a class="btn btn--outline" href={withBase("/about/contact-us")}>Chat with Us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================== products -- -->
  <SectionStrip title="Products" />

  <section class="section">
    <div class="container">
      <h2 class="section__title" data-reveal>🌐 Jivrus Product Suite</h2>
      <h3 class="section__sub" data-reveal>
        Discover the complete ecosystem of Jivrus products – from powerful form &amp; document
        automation to intelligent app integrations, Google Workspace extensions, CRM connectors, and
        analytics tools.Our suite is built to simplify, automate, and scale your business.
      </h3>
      <div class="product-grid" data-stagger>
        {
          products.map((p) => (
            <a class="product-card" id={p.id} href={withBase("/products")} data-stagger-item>
              <span class="product-card__name">{p.name}</span>
            </a>
          ))
        }
      </div>
      {
        productSuite && (
          <img
            class="suite-art"
            src={withBase(local(productSuite.src))}
            alt={productSuite.alt || 'Jivrus technology product suite diagram'}
            width={productSuite.w || undefined}
            height={productSuite.h || undefined}
            loading="lazy"
            decoding="async"
            data-reveal
          />
        )
      }
      <div class="btn-row">
        <a class="btn btn--outline" href={withBase("/products")} data-reveal>Explore all our Products</a>
      </div>
    </div>
  </section>

  <!-- ====================================================== what we do -- -->
  <SectionStrip title="What we do?" />

  <section class="section">
    <div class="container what">
      <div class="what__left">
        <h2 class="what__display" data-reveal>
          awesomeness redefined with integration intelligence and hyper-automation
        </h2>
        <a class="btn btn--outline what__cta" href={withBase("/about/company")} data-reveal>
          Read more about us
        </a>
      </div>
      <div class="what__right">
        <ul class="what__list">
          <li data-reveal>
            With intelligent integration and hyper-automation, business processes can be taken on
            auto-pilot mode for success.
          </li>
          <li data-reveal>
            We specialize in intelligent integration and hyper-automation with Applications, Products,
            Cloud, IoT and analytics to bring out the full potential of your business.
          </li>
          <li data-reveal>
            We research, conceive, produce, and maintain awesome software products worldwide to make
            customer business successful.
          </li>
          <li data-reveal>
            We are a technology partner with major platforms like Google, Microsoft, Zoho
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ==================================================== testimonials -- -->
  <SectionStrip title="Testimonials" />

  <section class="section section--blush">
    <div class="container">
      <div class="grid grid--2" data-stagger>
        {
          testimonials.map((t) => (
            <figure class="testimonial" data-stagger-item>
              {t.asHeading ? (
                <h3 class="testimonial__quote">{t.quote}</h3>
              ) : (
                t.quote.split('\n').map((line) => (
                  <blockquote class="testimonial__quote">
                    {line}
                  </blockquote>
                ))
              )}
              <figcaption><h3>~ {t.who}</h3></figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================= customers -- -->
  <SectionStrip title="Some of our customers" />

  <section class="section section--blush">
    <div class="container">
      <div class="customer-grid" data-stagger>
        {
          customers.map((c, i) => {
            // The source shows a customer logo in each card; pair them in
            // source order, and fall back to an empty tile when a logo is
            // unavailable rather than dropping the customer entry.
            const logo = logoTiles[i];
            return (
              <div class="customer" data-stagger-item>
                <div class="customer__logo">
                  {logo && (
                    <img
                      src={withBase(local(logo.src))}
                      alt={`${c.site} logo`}
                      width={logo.w || undefined}
                      height={logo.h || undefined}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>
                <p class="customer__site">{c.site}</p>
                <h3 class="customer__country">{c.country}</h3>
              </div>
            );
          })
        }
      </div>
      <div class="btn-row">
        <a class="btn btn--outline" href={withBase("/customers")} data-reveal>See more Customers</a>
      </div>
    </div>
  </section>

  <!-- ======================================================== partners -- -->
  <section class="section section--blush">
    <div class="container">
      <h2 class="section__title section__title--left" data-reveal>Partners</h2>
      <div class="partner-logos" data-reveal>
        <span class="partner-chip partner-chip--jivrus">Jivrus</span>
        <span class="partner-chip">Zoho Technology Partner</span>
        <span class="partner-chip">Google Cloud Partner</span>
      </div>
      <div class="grid grid--3 partner-cats" data-stagger>
        {
          ['Technology Partners', 'Integration Partners', 'Sales Partners'].map((c) => (
            <div class="partner-cat" data-stagger-item>
              <h3>{c}</h3>
            </div>
          ))
        }
      </div>
      <div class="btn-row">
        <a class="btn btn--outline" href={withBase("/about/partners")} data-reveal>Explore Partners</a>
      </div>
    </div>
  </section>

  <!-- ========================================================= history -- -->
  <SectionStrip title="History" />

  <section class="section">
    <div class="container">
      <div class="history" data-stagger>
        {
          history.map((h) => (
            <div class="history__item" data-stagger-item>
              <h3>{h.date}</h3>
            </div>
          ))
        }
      </div>
      <div class="btn-row">
        <a class="btn btn--outline" href={withBase("/about/our-history")} data-reveal>Read Full History</a>
      </div>
    </div>
  </section>

  <!-- ========================================================= say hi -- -->
  <section class="sayhi">
    <div class="container sayhi__inner">
      <h2 class="sayhi__title" data-reveal>Say hi</h2>
      <p class="sayhi__text" data-reveal>
        Email: support@jivrus.com &nbsp;·&nbsp; WhatsApp +91 79754 86266
        &nbsp;·&nbsp; Mon-Fri 9:00 AM to 7:00 PM IST
      </p>
      <div class="btn-row sayhi__btns" data-reveal>
        <a class="btn btn--ghost-light" href={withBase("/about/contact-us")}>Contact Us</a>
        <a class="btn btn--ghost-light" href={withBase("/about/contact-sales")}>Contact Sales</a>
      </div>
    </div>
  </section>

<style>

  /* ------------------------------------------------------------- hero -- */
  .hero {
    position: relative;
    background: linear-gradient(115deg, var(--hero-from) 0%, var(--hero-via) 48%, var(--hero-to) 100%);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }

  /* topographic contour texture, matching the source hero */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: repeating-radial-gradient(
      circle at 18% 42%,
      rgba(255, 255, 255, 0.13) 0 1px,
      transparent 1px 46px
    );
    background-size: 300px 300px;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 40px;
    /* clears the floating header + announcement bar on the homepage */
    padding-block: calc(var(--header-h) + 96px) 88px;
    min-height: 520px;
  }

  .hero__title {
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0 0 14px;
    text-align: center;
  }

  .hero__sub {
    font-size: clamp(16px, 2vw, 22px);
    color: rgba(255, 255, 255, 0.94);
    text-align: center;
    margin: 0 0 8px;
  }

  .hero__sub-tail {
    display: block;
  }

  .hero__wa {
    color: rgba(255, 255, 255, 0.9);
  }

  .hero__btns {
    margin-top: 26px;
  }

  .hero__links {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 22px;
    font-size: var(--fs-small);
  }

  .hero__links a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero__links a:hover {
    color: var(--jivrus-blush);
  }

  .hero__art {
    display: grid;
    place-items: center;
  }

  .hero__art-img {
    width: 100%;
    height: auto;
    max-width: 620px;
    /* The source artwork bleeds off the right edge of the hero. */
    margin-right: calc(var(--gutter) * -1);
    filter: drop-shadow(0 24px 60px rgba(0, 0, 0, 0.18));
  }

  /* The product-suite radial diagram from the source. */
  .suite-art {
    display: block;
    width: 100%;
    height: auto;
    max-width: 860px;
    margin: 30px auto 0;
    border-radius: var(--radius);
  }

  .hero__orb {
    position: absolute;
    inset: 22%;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.16);
    display: grid;
    place-items: center;
    font-family: var(--font-brand);
    font-weight: 700;
    font-size: clamp(22px, 3.4vw, 38px);
    color: var(--jivrus-magenta);
  }

  .hero__orb::after {
    content: 'Jivrus';
  }

  .hero__node {
    position: absolute;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
  }

  .hero__node::before,
  .hero__node::after {
    content: '';
    position: absolute;
    background: rgba(255, 255, 255, 0.45);
  }

  /* connective spokes, echoing the integration diagram */
  .hero__node::before {
    left: 50%;
    top: 50%;
    width: 140px;
    height: 1px;
    transform-origin: 0 50%;
    z-index: -1;
  }

  .hero__node--1 {
    top: 4%;
    left: 42%;
  }

  .hero__node--1::before {
    transform: rotate(64deg);
  }

  .hero__node--2 {
    top: 44%;
    right: 2%;
  }

  .hero__node--2::before {
    transform: rotate(180deg);
  }

  .hero__node--3 {
    bottom: 4%;
    left: 44%;
  }

  .hero__node--3::before {
    transform: rotate(-64deg);
  }

  .hero__node--4 {
    top: 44%;
    left: 2%;
  }

  .hero__node--4::before {
    transform: rotate(0deg);
  }

  /* ------------------------------------------------------------ portal */
  .portal {
    background: var(--jivrus-white);
    padding: 40px 0;
  }

  .portal__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 32px;
    align-items: center;
  }

  .portal__title {
    font-size: var(--fs-h1);
    color: var(--jivrus-magenta);
    font-weight: 700;
    margin: 0 0 6px;
  }

  .portal__sub {
    font-size: var(--fs-h2);
    color: var(--jivrus-magenta);
    font-weight: 700;
    margin: 0;
  }

  .portal__card {
    background: #edf7fb;
    border-radius: var(--radius-lg);
    padding: 22px 24px;
  }

  .portal__card-text {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--jivrus-ink);
  }

  .portal__card-btns {
    margin-top: 16px;
  }

  /* ---------------------------------------------------------- sections */
  .section__title {
    font-size: var(--fs-h2);
    color: var(--jivrus-magenta);
    font-weight: 700;
    text-align: center;
    margin: 0 0 16px;
  }

  .section__title--left {
    text-align: left;
  }

  .section__lead {
    max-width: 82ch;
    margin: 0 auto 34px;
    color: var(--jivrus-ink);
    text-align: center;
  }

  .section__sub {
    max-width: 82ch;
    margin: 0 auto 34px;
    color: var(--jivrus-magenta);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.45;
    text-align: center;
  }

  /* ---------------------------------------------------------- products */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }

  .product-card {
    display: grid;
    place-items: center;
    min-height: 92px;
    padding: 16px;
    background: var(--jivrus-white);
    border: 1px solid var(--jivrus-line);
    border-radius: var(--radius);
    text-align: center;
    font-weight: 500;
    color: var(--jivrus-ink);
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    border-color: var(--jivrus-magenta);
    color: var(--jivrus-magenta);
  }

  /* --------------------------------------------------------- what we do */
  .what {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 40px;
    align-items: start;
  }

  .what__display {
    font-size: clamp(24px, 3.4vw, 40px);
    color: #087df3;
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 22px;
  }

  .what__cta {
    display: inline-flex;
  }

  .what__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .what__list li {
    position: relative;
    padding-left: 26px;
    color: var(--jivrus-ink);
  }

  .what__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--jivrus-magenta);
  }

  /* ------------------------------------------------------ testimonials */
  .testimonial {
    margin: 0;
    padding: 22px;
    background: var(--jivrus-white);
    border-radius: var(--radius);
  }

  .testimonial blockquote,
  .testimonial__quote {
    margin: 0 0 10px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--jivrus-ink);
    font-size: var(--fs-small);
    font-weight: 400;
    line-height: 1.55;
  }

  .testimonial figcaption {
    color: var(--jivrus-magenta);
    font-size: var(--fs-small);
    font-weight: 700;
  }

  .testimonial figcaption h3 {
    font-size: inherit;
    font-weight: inherit;
  }

  /* --------------------------------------------------------- customers */
  .customer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 20px;
  }

  .customer {
    text-align: center;
  }

  .customer__logo {
    display: grid;
    place-items: center;
    height: 84px;
    padding: 10px;
    border-radius: var(--radius);
    background: var(--jivrus-white);
    box-shadow: var(--shadow-sm);
    margin-bottom: 10px;
  }

  .customer__logo img {
    max-width: 100%;
    max-height: 64px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .customer__site {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--jivrus-ink);
  }

  .customer__country {
    margin: 0;
    font-size: var(--fs-micro);
    font-weight: 400;
    color: var(--jivrus-magenta);
  }

  /* ---------------------------------------------------------- partners */
  .partner-logos {
