---
import { withBase } from '~/lib/urls';
/**
 * SocialRow — the circular social icons in the footer. The live site links out
 * to Jivrus's profiles; these are preserved as real external links.
 */
const networks = [
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/jivrus/',
    path: 'M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12z',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/company/jivrus/',
    path: 'M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.76-2.05 4.02 0 4.76 2.5 4.76 5.76V21h-4v-5.6c0-1.34-.03-3.06-1.9-3.06-1.9 0-2.2 1.45-2.2 2.96V21H9z',
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/jivrus/',
    path: 'M12 2.2c3.2 0 3.6 0 4.9.07 1.2.06 1.8.25 2.2.42.6.22 1 .48 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c0 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2 0-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c0-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.8.07-1.1.05-1.7.24-2.1.4-.5.2-.9.44-1.2.8-.4.3-.6.7-.8 1.2-.2.4-.4 1-.4 2.1C2.6 8.9 2.6 9.3 2.6 12s0 3.1.1 4.4c0 1.1.2 1.7.4 2.1.2.5.4.9.8 1.2.3.4.7.6 1.2.8.4.2 1 .4 2.1.4 1.3.1 1.7.1 4.8.1s3.5 0 4.8-.1c1.1 0 1.7-.2 2.1-.4.5-.2.9-.4 1.2-.8.4-.3.6-.7.8-1.2.2-.4.4-1 .4-2.1.1-1.3.1-1.7.1-4.4s0-3.1-.1-4.4c0-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.2a3.2 3.2 0 0 0-1.2-.8c-.4-.2-1-.4-2.1-.4C15.5 4 15.1 4 12 4zm0 3a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 8.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zm6.4-8.4a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z',
  },
  {
    label: 'YouTube',
    href: 'https://www.youtube.com/@jivrus',
    path: 'M23 12s0-3.8-.5-5.6a2.9 2.9 0 0 0-2-2C18.7 4 12 4 12 4s-6.7 0-8.5.4a2.9 2.9 0 0 0-2 2C1 8.2 1 12 1 12s0 3.8.5 5.6a2.9 2.9 0 0 0 2 2C5.3 20 12 20 12 20s6.7 0 8.5-.4a2.9 2.9 0 0 0 2-2C23 15.8 23 12 23 12zM9.8 15.3V8.7l5.7 3.3z',
  },
  {
    label: 'X',
    href: 'https://x.com/jivrus',
    path: 'M18.9 2H22l-7 8 8.2 12h-6.4l-5-7.3L5.9 22H2.7l7.5-8.6L2.3 2h6.6l4.5 6.7zm-1.1 18.1h1.7L7.3 3.8H5.5z',
  },
];
---

<ul class="social" aria-label="Jivrus social media">
  {
    networks.map((n) => (
      <li>
        <a
          class="social__link"
          href={withBase(n.href)}
          target="_blank"
          rel="noopener noreferrer me"
          aria-label={`Jivrus on ${n.label}`}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d={n.path} fill="currentColor" />
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .social__link {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--jivrus-blush);
    color: var(--jivrus-magenta);
    transition: transform var(--dur) var(--ease-out), background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }

  .social__link:hover {
    transform: translateY(-4px) scale(1.06);
    background: var(--jivrus-magenta);
    color: var(--jivrus-white);
    box-shadow: 0 8px 20px rgba(208, 23, 82, 0.3);
  }
</style>
