 "title": "Jivrus Technologies - Whitelisting Google Workspace Apps",
 "description": "Some users may not be able to install our Google Workspace add-ons as some error appears during the installation of the add-on.",
 "h1": "Whitelisting Google Workspace Marketplace Apps",
 "ogImage": "",
 "ogUrl": "https://www.jivrus.com/resources/articles/google-workspace/whitelisting-google-workspace-apps",
 "sections": [
  {
   "kind": "grid",
