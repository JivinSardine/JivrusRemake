  {
   "tag": "h3",
   "text": "I am seeing only the Help menu in the add-on. Why?",
   "href": "",
   "src": "",
   "alt": "",
   "size": "17.3333px",
   "color": "rgb(208, 23, 82)",
   "anchor": "i-am-seeing-only-the-help-menu-in-the-add-on-why"
  },
  {
