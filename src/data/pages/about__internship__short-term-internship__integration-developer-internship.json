     "color": "rgb(33, 33, 33)"
    },
    {
     "tag": "li",
     "text": "Document Bugs",
     "href": "",
     "src": "",
     "alt": "",
     "size": "16px",
     "color": "rgb(33, 33, 33)"
    },
    {
     "tag": "li",
     "text": "Include steps to reproduce the defect, expected behavior, and actual behavior.",
     "href": "",
     "src": "",
     "alt": "",
     "size": "16px",
     "color": "rgb(33, 33, 33)"
    },
    {
     "tag": "li",
     "text": "Attach relevant screenshots or logs to support the report.",
     "href": "",
     "src": "",
     "alt": "",
     "size": "16px",
     "color": "rgb(33, 33, 33)"
    },
    {
     "tag": "li",
     "text": "Prioritize defects based on factors like customer impact, risk, and criticality.",
     "href": "",
     "src": "",
     "alt": "",
     "size": "16px",
     "color": "rgb(33, 33, 33)"
    },
    {
     "tag": "li",
     "text": "Discuss and review.",
     "href": "",
     "src": "",
     "alt": "",
     "size": "16px",
     "color": "rgb(33, 33, 33)"
    },
    {
     "tag": "li",
     "text": "Verify the bug fixes",
     "href": "",
