 "title": "Jivrus Technologies - Safety",
 "description": "What is Data Safety?",
 "h1": "Safety",
 "ogImage": "",
 "ogUrl": "https://www.jivrus.com/legal/safety",
 "sections": [
  {
   "kind": "grid",
   "blocks": [
    {
     "tag": "img",
