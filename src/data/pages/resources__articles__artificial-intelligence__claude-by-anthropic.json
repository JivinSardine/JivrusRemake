    {
     "tag": "h2",
     "text": "\"Anthropic AI spearheads the evolution of artificial intelligence, driving innovation to uplift humanity\"",
     "href": "",
     "src": "",
     "alt": "",
     "size": "24px",
     "color": "rgb(208, 23, 82)",
     "anchor": "anthropic-ai-spearheads-the-evolution-of-artificial-intelligence-driving-innovation-to-uplift-humanity"
