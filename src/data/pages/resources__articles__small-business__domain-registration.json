   "text": "We have registered several domains for ourselves and for our clients in godaddy.com",
   "href": "",
   "src": "",
   "alt": "",
   "size": "16px",
   "color": "rgb(33, 33, 33)"
  },
  {
   "tag": "p",
   "text": "Easy to get started.",
   "href": "",
   "src": "",
   "alt": "",
   "size": "16px",
   "color": "rgb(33, 33, 33)"
  },
  {
   "tag": "p",
   "text": "The domain management GUI is not very intuitive for beginners to do advanced settings.",
   "href": "",
   "src": "",
   "alt": "",
   "size": "16px",
   "color": "rgb(33, 33, 33)"
  },
  {
   "tag": "h2",
   "text": "2. Google Domains (domains.google.com)",
   "href": "",
   "src": "",
   "alt": "",
   "size": "24px",
   "color": "rgb(208, 23, 82)",
   "anchor": "2-google-domains-domains-google-com"
