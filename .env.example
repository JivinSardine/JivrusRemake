# JivrusRemake — environment
#
# This project is a fully static site. No environment variables are required
# to build, preview, or deploy it.
#
# Copy this file to `.env` only if you need to override a build-time value.
# `.env` is gitignored; never commit real credentials.

# Origin used for canonical URLs, Open Graph tags, and the generated sitemap.
# Default: https://www.jivrus.com
# PUBLIC_SITE_URL=https://www.jivrus.com

# Optional: only needed if you run the Playwright QA scripts against a
# locally-served build rather than the default preview port.
# QA_BASE_URL=http://127.0.0.1:4321
